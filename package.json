{
  "name": "incident-tracker-backend",
  "version": "0.1.0",
  "description": "Backend for the Real-Time Incident Tracking & Service Desk Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:demo": "node scripts/seed-demo.js",
    "sla:escalate": "node scripts/run-escalation.js",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "public/js/dashboard-utils.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "./src/domain/": {
        "statements": 98,
        "branches": 95,
        "functions": 100,
        "lines": 98
      },
      "./src/services/incidentService.js": {
        "statements": 98,
        "branches": 94,
        "functions": 100,
        "lines": 98
      }
    }
  }
}
